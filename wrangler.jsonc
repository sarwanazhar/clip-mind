{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipmind",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipmind-db",
      "database_id": "a055cc0d-83fd-4e38-a40c-f6dc79b0ae9b"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "clipmind-embeddings"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "clipmind-vault"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "6158f6fcf7cf4a4e81ddd4684acd5a62"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "clip-pipeline-workflow",
      "binding": "CLIP_WORKFLOW",
      "class_name": "ClipPipelineWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRESS_DO",
        "class_name": "ProgressRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProgressRoomDO"]
    }
  ]
}
